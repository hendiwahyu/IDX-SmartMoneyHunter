//@version=5
indicator("IDX Smart Money Hunter PRO", shorttitle="SMH PRO", overlay=true)

//=====================================================
// INPUT
//=====================================================
groupTrend = "Trend"

emaFastLength = input.int(9, "EMA Fast", group=groupTrend)
emaSlowLength = input.int(20, "EMA Slow", group=groupTrend)

groupVolume = "Volume"

volumeLength = input.int(20, "Volume Average", group=groupVolume)

groupDisplay = "Display"

showEMA = input.bool(true, "Show EMA", group=groupDisplay)
showVWAP = input.bool(true, "Show VWAP", group=groupDisplay)

//=====================================================
// EMA ENGINE
//=====================================================
emaFast = ta.ema(close, emaFastLength)
emaSlow = ta.ema(close, emaSlowLength)

trendBull = emaFast > emaSlow

plot(showEMA ? emaFast : na, color=color.lime, linewidth=2, title="EMA Fast")
plot(showEMA ? emaSlow : na, color=color.orange, linewidth=2, title="EMA Slow")

//=====================================================
// VWAP ENGINE
//=====================================================
vwapLine = ta.vwap(hlc3)

plot(showVWAP ? vwapLine : na,
     color=color.aqua,
     linewidth=2,
     title="VWAP")

aboveVWAP = close > vwapLine

//=====================================================
// RVOL ENGINE
//=====================================================
averageVolume = ta.sma(volume, volumeLength)

rvol =
    averageVolume > 0
    ? volume / averageVolume
    : 0.0

//=====================================================
// MONEY FLOW ENGINE
//=====================================================
typicalPrice = hlc3

moneyFlow = typicalPrice * volume

averageMoneyFlow = ta.sma(moneyFlow, volumeLength)

moneyFlowRatio =
    averageMoneyFlow > 0
    ? moneyFlow / averageMoneyFlow
    : 0.0


//=====================================================
// SMART MONEY ENGINE
//=====================================================

// Candle Metrics
body = math.abs(close - open)
candleRange = high - low

bodyRatio = candleRange > 0 ? body / candleRange : 0.0

upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

// Average
avgBody = ta.sma(body, 20)
avgRange = ta.sma(candleRange, 20)

// Conditions
highRVOL = rvol >= 2.0

highMoney = moneyFlowRatio >= 1.5

smallBody = body < avgBody

tightRange = candleRange < avgRange

strongClose = candleRange > 0 ? close >= low + candleRange * 0.70 : false

longLowerWick = lowerWick > body

// Smart Money Conditions
absorption =
    highRVOL and
    highMoney and
    smallBody and
    strongClose

accumulation =
    absorption and
    tightRange

breakoutReady =
    accumulation and
    aboveVWAP and
    trendBull


//=====================================================
// SMART SCORE
//=====================================================

smartScore = 0.0

smartScore += highRVOL ? 20 : 0
smartScore += highMoney ? 20 : 0
smartScore += smallBody ? 15 : 0
smartScore += strongClose ? 15 : 0
smartScore += tightRange ? 10 : 0
smartScore += aboveVWAP ? 10 : 0
smartScore += trendBull ? 10 : 0

//=====================================================
// STATUS
//=====================================================

string smartStatus = "NO SIGNAL"

if breakoutReady
    smartStatus := "BREAKOUT READY"
else if accumulation
    smartStatus := "EARLY ACCUMULATION"
else if absorption
    smartStatus := "ABSORPTION"


plotshape(
     accumulation,
     title="Accumulation",
     style=shape.circle,
     color=color.yellow,
     size=size.tiny,
     location=location.belowbar)

plotshape(
     breakoutReady,
     title="Breakout Ready",
     style=shape.triangleup,
     color=color.lime,
     size=size.small,
     location=location.belowbar)


//=====================================================
// PLOT INFO
//=====================================================
plot(rvol,
     title="RVOL",
     display=display.data_window)

plot(moneyFlowRatio,
     title="Money Flow Ratio",
     display=display.data_window)

//=====================================================
// STATUS
//=====================================================
var label info = na

if barstate.islast

    label.delete(info)

    txt =
         txt =
     "Trend : " + (trendBull ? "Bullish" : "Bearish") +
     "\nRVOL : " + str.tostring(rvol, "#.##") +
     "\nMoney : " + str.tostring(moneyFlowRatio, "#.##") +
     "\nScore : " + str.tostring(smartScore, "#") +
     "\nStatus : " + smartStatus

    info :=
         label.new(
             bar_index,
             high,
             txt,
             style=label.style_label_down,
             color=color.black,
             textcolor=color.white)